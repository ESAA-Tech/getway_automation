    {
      "portid": "green_level",
      "startaddr": "1",
      "addrtype": "03(4X)",
      "datatype": "u16",
      "datanum": 1,
      "rdwr": "rw",
      "cal_type": "disabled",
      "formula": "",
      "description": "Green Channel Intensity (0-255)"
    },
    {
      "portid": "blue_level",
      "startaddr": "2",
      "addrtype": "03(4X)",
      "datatype": "u16",
      "datanum": 1,
      "rdwr": "rw",
      "cal_type": "disabled",
      "formula": "",
