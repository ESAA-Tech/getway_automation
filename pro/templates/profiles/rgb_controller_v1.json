    },
    {
      "portid": "power_state",
      "startaddr": "5",
      "addrtype": "03(4X)",
      "datatype": "u16",
      "datanum": 1,
      "rdwr": "rw",
      "cal_type": "disabled",
      "formula": "",
      "description": "RGB Power State Relay (0: Off, 1: On)"
